# AI Provider: 'mock' (default, no API key needed), 'claude', or 'openai'
AI_PROVIDER=mock

# Server Port
PORT=8000

# Optional: Real AI API Keys (used if AI_PROVIDER is set to claude or openai)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: Path to Tesseract OCR binary (if not in system PATH)
# Example (Windows): C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
